{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [],
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "preserve",
    "types": [
      "node",
      "mocha", "chai", "chai-as-promised"
    ]
  },
  "include": [
    "hardhat.config.ts",
    "contracts/**/*.ts",
    "contracts/artifacts/**/*.d.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/hooks.ts",
    "src/lib/wagmi.ts"
  ]
}