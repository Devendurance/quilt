# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# quilt contract toolchain (keep empty dirs so `hardhat compile` works pre-contracts)
/contracts/artifacts/*
!/contracts/artifacts/.gitkeep
/contracts/cache/*
!/contracts/cache/.gitkeep
/typechain-types

# fast-build session state (local only, never commit)
.fast-build/

# deployment secrets (artifacts like deployments/968.json are committed; keys never are)
*.secret.json
deployer.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
