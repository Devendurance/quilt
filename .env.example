# Public, committable sample config. Never put private keys or seed phrases here.
# Deployment keys live only in local shell env / secret store, funded with small test amounts.

# --- Chain endpoints (public) ---
BOHR_RPC_URL=https://rpc.bohr.life
BOTCHAIN_RPC_URL=https://rpc.botchain.ai

# --- Deployed QuiltSplits addresses (filled after verified deploys; empty = fail closed) ---
NEXT_PUBLIC_QUILT_CONTRACT_ADDRESS_968=
NEXT_PUBLIC_QUILT_CONTRACT_ADDRESS_677=

# --- Local-only secrets (NEVER commit, NEVER prefix with NEXT_PUBLIC_) ---
# DEPLOYER_PRIVATE_KEY=0x...   # creator/deployer wallet (Slice C)
# PAYER_PRIVATE_KEY=0x...      # different payer wallet (Slice C; must differ)
# QUILT_CONTRACT_968=0x...     # optional: reuse a verified 968 deployment
